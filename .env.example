APP_ENV=development
# Explicit local direct-run option. Production must use a PostgreSQL URL.
DATABASE_URL=sqlite:///./nurtelora.db
# Compose uses these local-only values to build DATABASE_URL for its PostgreSQL service.
POSTGRES_USER=nurtelora
POSTGRES_PASSWORD=local-only-password
POSTGRES_DB=nurtelora
PHONE_HASH_SECRET=
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_TIMEOUT_SECONDS=60
NATLAS_MAX_RETRIES=2
NATLAS_ENABLED=false
NATLAS_LANGUAGES=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_GRAPH_API_VERSION=
WHATSAPP_WEBHOOK_PATH=/webhooks/whatsapp
MAX_AUDIO_BYTES=16777216
